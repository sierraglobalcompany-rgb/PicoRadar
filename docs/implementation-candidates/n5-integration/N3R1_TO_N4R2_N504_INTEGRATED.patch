diff --git a/mobile/lib/core/sync/published_catalog_store.dart b/mobile/lib/core/sync/published_catalog_store.dart
new file mode 100644
index 0000000..297a6d4
--- /dev/null
+++ b/mobile/lib/core/sync/published_catalog_store.dart
@@ -0,0 +1,286 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:cryptography/cryptography.dart';
+
+import '../database/app_database.dart';
+import 'dataset_sync_service.dart';
+
+/// A small, typed snapshot adapter for existing catalog DTOs. DatasetSyncService
+/// remains the ONLY network client, manifest validator and Drift version writer.
+/// Files are immutable and named by the SHA-256 recorded in dataset_versions.
+class PublishedCatalogStore<T> {
+  PublishedCatalogStore({
+    required this.database,
+    required this.datasetKey,
+    required this.snapshotFile,
+    required this.bundledLoader,
+    required this.parse,
+  });
+
+  final AppDatabase database;
+  final String datasetKey;
+  final File snapshotFile;
+  final Future<String> Function() bundledLoader;
+  final T Function(String source) parse;
+  final _CatalogMutex _mutex = _CatalogMutex();
+  final Map<String, int> _pending = {};
+  String? lastLoadWarning;
+  String? lastMaintenanceWarning;
+
+  TransactionalDatasetImporter get transactionalImporter =>
+      TransactionalDatasetImporter(
+        prepare: _prepare,
+        isInstalledVersionUsable: _isInstalledVersionUsable,
+      );
+
+  Future<T> load() => _mutex.run(() async {
+    final installed = await _installed();
+    if (installed == null || installed.status != 'installed') {
+      lastLoadWarning = null;
+      return parse(await bundledLoader());
+    }
+    try {
+      final value = await _readInstalled(installed);
+      lastLoadWarning = null;
+      return value;
+    } on DatasetSyncException {
+      return _bundledFallback();
+    } on FileSystemException {
+      return _bundledFallback();
+    }
+  });
+
+  Future<T> _bundledFallback() async {
+    lastLoadWarning =
+        'El catálogo descargado no pasó la comprobación de integridad. '
+        'Se muestra la copia incluida en la aplicación.';
+    return parse(await bundledLoader());
+  }
+
+  Future<DatasetVersion?> _installed() async {
+    final found = await (database.select(database.datasetVersions)
+          ..where((row) => row.datasetKey.equals(datasetKey)))
+        .get();
+    if (found.length > 1) {
+      throw DatasetSyncException('Duplicate installed dataset: $datasetKey.');
+    }
+    return found.isEmpty ? null : found.single;
+  }
+
+  File _snapshot(String sha) => File('${snapshotFile.path}.$sha');
+
+  Future<T> _readInstalled(DatasetVersion installed) async {
+    final sha = installed.sha256?.trim() ?? '';
+    if (!_sha256Pattern.hasMatch(sha)) {
+      throw DatasetSyncException('Invalid installed hash for $datasetKey.');
+    }
+    final bytes = await _snapshot(sha).readAsBytes();
+    if (await _digest(bytes) != sha) {
+      throw DatasetSyncException('Installed bytes changed for $datasetKey.');
+    }
+    try {
+      final source = utf8.decode(bytes);
+      final json = jsonDecode(source);
+      if (json is! Map || json['datasetKey'] != datasetKey ||
+          json['version'] != installed.version || json['schemaVersion'] != 1) {
+        throw const FormatException('Installed envelope mismatch.');
+      }
+      return parse(source);
+    } catch (error) {
+      throw DatasetSyncException('Installed $datasetKey is invalid: $error');
+    }
+  }
+
+  Future<bool> _isInstalledVersionUsable(
+    AppDatabase target,
+    DatasetVersion installed,
+  ) async {
+    if (!identical(target, database) || installed.datasetKey != datasetKey ||
+        installed.status != 'installed') {
+      return false;
+    }
+    return _mutex.run(() async {
+      try {
+        await _readInstalled(installed);
+        return true;
+      } on Exception {
+        return false;
+      }
+    });
+  }
+
+  Future<PreparedDatasetImport> _prepare(
+    AppDatabase target,
+    Map<String, dynamic> payload,
+    List<int> verifiedBytes,
+    String sha,
+  ) async {
+    if (!identical(target, database) || !_sha256Pattern.hasMatch(sha) ||
+        await _digest(verifiedBytes) != sha) {
+      throw DatasetSyncException('Invalid verified bytes for $datasetKey.');
+    }
+    try {
+      final source = utf8.decode(verifiedBytes);
+      final decoded = jsonDecode(source);
+      if (decoded is! Map || !_sameJson(decoded, payload) ||
+          decoded['datasetKey'] != datasetKey ||
+          decoded['schemaVersion'] != 1 ||
+          decoded['version'] is! String ||
+          (decoded['version'] as String).trim().isEmpty ||
+          DateTime.tryParse(decoded['generatedAt']?.toString() ?? '') == null) {
+        throw const FormatException('Catalog envelope does not match bytes.');
+      }
+      // The same parser used by the UI must accept the candidate BEFORE Drift
+      // records its version. No committed but unreadable catalog is allowed.
+      parse(source);
+    } catch (error) {
+      throw DatasetSyncException('Invalid published $datasetKey: $error');
+    }
+
+    return _mutex.run(() async {
+      await snapshotFile.parent.create(recursive: true);
+      final destination = _snapshot(sha);
+      var created = false;
+      final present = await destination.exists();
+      final intact = present &&
+          await _digest(await destination.readAsBytes()) == sha;
+      if (!intact) {
+        final nonce = DateTime.now().microsecondsSinceEpoch;
+        final candidate = File('${destination.path}.candidate.$nonce');
+        final quarantine = File('${destination.path}.corrupt.$nonce');
+        var quarantined = false;
+        try {
+          await candidate.writeAsBytes(verifiedBytes, flush: true);
+          // Never write partial bytes to a selected snapshot. A damaged file
+          // is moved out of the way only after the replacement is complete.
+          if (present) {
+            await destination.rename(quarantine.path);
+            quarantined = true;
+          }
+          await candidate.rename(destination.path);
+          created = true;
+        } on FileSystemException {
+          if (quarantined && !await destination.exists()) {
+            await quarantine.rename(destination.path);
+          }
+          if (!await destination.exists() ||
+              await _digest(await destination.readAsBytes()) != sha) {
+            rethrow;
+          }
+        } finally {
+          if (await candidate.exists()) await candidate.delete();
+          if (await quarantine.exists()) await quarantine.delete();
+        }
+      }
+      _pending.update(sha, (count) => count + 1, ifAbsent: () => 1);
+      return _PreparedCatalog<T>(this, sha, created);
+    });
+  }
+
+  Future<void> _finish(String sha, bool created, {required bool committed}) =>
+      _mutex.run(() async {
+        final count = _pending[sha] ?? 0;
+        if (count <= 1) {
+          _pending.remove(sha);
+        } else {
+          _pending[sha] = count - 1;
+        }
+        if (committed) {
+          // Cleanup is best-effort, never invalidate a successful DB commit.
+          try {
+            final selected = await _installed();
+            if (selected?.sha256 == sha) {
+              final prefix = '${snapshotFile.uri.pathSegments.last}.';
+              await for (final entity in snapshotFile.parent.list()) {
+                if (entity is! File) continue;
+                final name = entity.uri.pathSegments.last;
+                if (!name.startsWith(prefix)) continue;
+                final suffix = name.substring(prefix.length);
+                if (suffix != sha && !_pending.containsKey(suffix) &&
+                    _sha256Pattern.hasMatch(suffix)) {
+                  await entity.delete();
+                }
+              }
+            }
+          } on Exception {
+            lastMaintenanceWarning = 'Old snapshot cleanup deferred.';
+          }
+        } else if (created && !_pending.containsKey(sha)) {
+          try {
+            final selected = await _installed();
+            if (selected?.sha256 != sha) {
+              final snapshot = _snapshot(sha);
+              if (await snapshot.exists()) await snapshot.delete();
+            }
+          } on Exception {
+            lastMaintenanceWarning = 'Unselected snapshot cleanup deferred.';
+          }
+        }
+      });
+}
+
+class _PreparedCatalog<T> implements PreparedDatasetImport {
+  _PreparedCatalog(this.store, this.sha, this.created);
+  final PublishedCatalogStore<T> store;
+  final String sha;
+  final bool created;
+  bool _finished = false;
+
+  @override
+  Future<void> activate() async {}
+
+  @override
+  Future<void> commit() async {
+    if (_finished) return;
+    _finished = true;
+    await store._finish(sha, created, committed: true);
+  }
+
+  @override
+  Future<void> rollback() async {
+    if (_finished) return;
+    _finished = true;
+    await store._finish(sha, created, committed: false);
+  }
+}
+
+class _CatalogMutex {
+  Future<void> _last = Future.value();
+
+  Future<T> run<T>(Future<T> Function() action) async {
+    final previous = _last;
+    final completer = Completer<void>();
+    _last = completer.future;
+    await previous;
+    try {
+      return await action();
+    } finally {
+      completer.complete();
+    }
+  }
+}
+
+final _sha256Pattern = RegExp(r'^[a-f0-9]{64}$');
+
+Future<String> _digest(List<int> bytes) async {
+  final hash = await Sha256().hash(bytes);
+  return hash.bytes.map((byte) => byte.toRadixString(16).padLeft(2, '0')).join();
+}
+
+bool _sameJson(Object? left, Object? right) {
+  if (left is Map && right is Map) {
+    return left.length == right.length &&
+        left.keys.every((key) => right.containsKey(key) &&
+            _sameJson(left[key], right[key]));
+  }
+  if (left is List && right is List) {
+    if (left.length != right.length) return false;
+    for (var i = 0; i < left.length; i++) {
+      if (!_sameJson(left[i], right[i])) return false;
+    }
+    return true;
+  }
+  return left == right;
+}
diff --git a/mobile/lib/features/account/data/app_account_client.dart b/mobile/lib/features/account/data/app_account_client.dart
new file mode 100644
index 0000000..2ec8160
--- /dev/null
+++ b/mobile/lib/features/account/data/app_account_client.dart
@@ -0,0 +1,268 @@
+import 'dart:convert';
+
+import 'package:dio/dio.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../../../core/storage/app_secure_storage.dart';
+import 'app_account_config.dart';
+
+const appAccountTokenStorageKey = 'app_account_access_token_v1';
+
+final appAccountClientProvider = Provider<AppAccountClient>((ref) {
+  final dio = Dio(
+    BaseOptions(
+      connectTimeout: const Duration(seconds: 10),
+      receiveTimeout: const Duration(seconds: 15),
+      sendTimeout: const Duration(seconds: 10),
+      followRedirects: false,
+    ),
+  );
+  ref.onDispose(() => dio.close(force: true));
+  return HttpAppAccountClient(dio, config: ref.watch(appAccountConfigProvider));
+});
+
+abstract interface class AppAccountClient {
+  Future<void> requestOtp(String email, {required bool privacyAccepted});
+  Future<AppAccountProfile> verifyOtp(String email, String code);
+  Future<AppAccountProfile> loadProfile();
+  Future<AppAccountProfile> updateProfile({
+    required String name,
+    required String phone,
+    required String municipality,
+    required List<String> categories,
+  });
+  Future<bool> updateMarketing(bool accepted);
+  Future<void> logout();
+  Future<void> suppress();
+}
+
+class HttpAppAccountClient implements AppAccountClient {
+  HttpAppAccountClient(
+    this._dio, {
+    required this.config,
+    AppAccountTokenStorage? storage,
+  }) : _storage = storage ?? SecureAppAccountTokenStorage(AppSecureStorage());
+
+  final Dio _dio;
+  final AppAccountConfig config;
+  final AppAccountTokenStorage _storage;
+
+  @override
+  Future<void> requestOtp(String email, {required bool privacyAccepted}) async {
+    await _send(
+      'POST',
+      '/api/v1/app-accounts/otp',
+      body: {'email': email.trim(), 'privacyAccepted': privacyAccepted},
+    );
+  }
+
+  @override
+  Future<AppAccountProfile> verifyOtp(String email, String code) async {
+    final data = await _send(
+      'POST',
+      '/api/v1/app-accounts/otp/verify',
+      body: {'email': email.trim(), 'code': code.trim()},
+    );
+    final token = data['token'];
+    if (token is! String || !RegExp(r'^[a-f0-9]{64}$').hasMatch(token)) {
+      throw const AppAccountFailure('invalid_response');
+    }
+    await _storage.writeSecret(appAccountTokenStorageKey, token);
+    final profile = data['profile'];
+    if (profile is! Map) throw const AppAccountFailure('invalid_response');
+    return AppAccountProfile.fromJson(Map<String, Object?>.from(profile));
+  }
+
+  @override
+  Future<AppAccountProfile> loadProfile() async {
+    final data = await _send('GET', '/api/v1/app-account', authenticated: true);
+    final profile = data['profile'];
+    if (profile is! Map) throw const AppAccountFailure('invalid_response');
+    return AppAccountProfile.fromJson(Map<String, Object?>.from(profile));
+  }
+
+  @override
+  Future<AppAccountProfile> updateProfile({
+    required String name,
+    required String phone,
+    required String municipality,
+    required List<String> categories,
+  }) async {
+    final data = await _send(
+      'PATCH',
+      '/api/v1/app-account',
+      authenticated: true,
+      body: {
+        'name': name.trim().isEmpty ? null : name.trim(),
+        'phone': phone.trim().isEmpty ? null : phone.trim(),
+        'municipality': municipality.trim().isEmpty
+            ? null
+            : municipality.trim(),
+        'categories': categories,
+      },
+    );
+    final profile = data['profile'];
+    if (profile is! Map) throw const AppAccountFailure('invalid_response');
+    return AppAccountProfile.fromJson(Map<String, Object?>.from(profile));
+  }
+
+  @override
+  Future<bool> updateMarketing(bool accepted) async {
+    final data = await _send(
+      'PATCH',
+      '/api/v1/app-account/marketing',
+      authenticated: true,
+      body: {'marketingConsent': accepted},
+    );
+    return data['marketingConsent'] == true;
+  }
+
+  @override
+  Future<void> logout() async {
+    await _send('POST', '/api/v1/app-account/logout', authenticated: true);
+    await _storage.deleteSecret(appAccountTokenStorageKey);
+  }
+
+  @override
+  Future<void> suppress() async {
+    await _send('DELETE', '/api/v1/app-account', authenticated: true);
+    await _storage.deleteSecret(appAccountTokenStorageKey);
+  }
+
+  Future<Map<String, Object?>> _send(
+    String method,
+    String path, {
+    Map<String, Object?>? body,
+    bool authenticated = false,
+  }) async {
+    final base = config.apiBaseUri;
+    if (!config.isAvailable || base == null) {
+      throw const AppAccountFailure('not_configured');
+    }
+    final token = authenticated
+        ? await _storage.readSecret(appAccountTokenStorageKey)
+        : null;
+    if (authenticated && token == null) {
+      throw const AppAccountFailure('unauthorized');
+    }
+    final headers = <String, Object>{'Accept': 'application/json'};
+    if (token != null) headers['Authorization'] = 'Bearer $token';
+    try {
+      final response = await _dio.request<Object?>(
+        base.resolve(path).toString(),
+        data: body,
+        options: Options(
+          method: method,
+          headers: headers,
+          followRedirects: false,
+        ),
+      );
+      if (response.statusCode == 204) return <String, Object?>{};
+      final decoded = _decode(response.data);
+      if ((response.statusCode ?? 500) < 200 ||
+          (response.statusCode ?? 500) >= 300) {
+        throw AppAccountFailure(_errorCode(decoded));
+      }
+      final data = decoded?['data'];
+      return data is Map
+          ? Map<String, Object?>.from(data)
+          : <String, Object?>{};
+    } on AppAccountFailure {
+      rethrow;
+    } on DioException catch (error) {
+      final data = _decode(error.response?.data);
+      throw AppAccountFailure(
+        error.response?.statusCode == 503 ? 'not_configured' : _errorCode(data),
+      );
+    } on FormatException {
+      throw const AppAccountFailure('invalid_response');
+    } on TypeError {
+      throw const AppAccountFailure('invalid_response');
+    }
+  }
+
+  Map<String, Object?>? _decode(Object? source) {
+    final value = source is String ? jsonDecode(source) : source;
+    return value is Map ? Map<String, Object?>.from(value) : null;
+  }
+
+  String _errorCode(Map<String, Object?>? response) {
+    const safe = {
+      'not_configured',
+      'unauthorized',
+      'rate_limited',
+      'validation_failed',
+      'invalid_or_expired_code',
+      'server_error',
+      'secure_transport_required',
+    };
+    final error = response?['error'];
+    final code = error is Map ? error['code']?.toString() : null;
+    return safe.contains(code) ? code! : 'server_error';
+  }
+}
+
+abstract interface class AppAccountTokenStorage {
+  Future<String?> readSecret(String key);
+  Future<void> writeSecret(String key, String value);
+  Future<void> deleteSecret(String key);
+}
+
+class SecureAppAccountTokenStorage implements AppAccountTokenStorage {
+  const SecureAppAccountTokenStorage(this.storage);
+
+  final AppSecureStorage storage;
+
+  @override
+  Future<String?> readSecret(String key) => storage.readSecret(key);
+
+  @override
+  Future<void> writeSecret(String key, String value) =>
+      storage.writeSecret(key, value);
+
+  @override
+  Future<void> deleteSecret(String key) => storage.deleteSecret(key);
+}
+
+class AppAccountProfile {
+  const AppAccountProfile({
+    required this.id,
+    required this.name,
+    required this.email,
+    required this.phone,
+    required this.municipality,
+    required this.categories,
+    required this.privacyVersion,
+    required this.marketingConsent,
+  });
+
+  final String id;
+  final String name;
+  final String email;
+  final String phone;
+  final String municipality;
+  final List<String> categories;
+  final String privacyVersion;
+  final bool marketingConsent;
+
+  factory AppAccountProfile.fromJson(Map<String, Object?> json) {
+    return AppAccountProfile(
+      id: json['id']?.toString() ?? '',
+      name: json['name']?.toString() ?? '',
+      email: json['email']?.toString() ?? '',
+      phone: json['phone']?.toString() ?? '',
+      municipality: json['municipality']?.toString() ?? '',
+      categories: (json['categories'] as List? ?? const [])
+          .map((value) => value.toString())
+          .toList(growable: false),
+      privacyVersion: json['privacyVersion']?.toString() ?? '',
+      marketingConsent: json['marketingConsent'] == true,
+    );
+  }
+}
+
+class AppAccountFailure implements Exception {
+  const AppAccountFailure(this.code);
+
+  final String code;
+}
diff --git a/mobile/lib/features/account/data/app_account_config.dart b/mobile/lib/features/account/data/app_account_config.dart
new file mode 100644
index 0000000..4a944d2
--- /dev/null
+++ b/mobile/lib/features/account/data/app_account_config.dart
@@ -0,0 +1,81 @@
+import 'package:flutter/foundation.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+final appAccountConfigProvider = Provider<AppAccountConfig>(
+  (ref) => AppAccountConfig.fromEnvironment(),
+);
+
+class AppAccountConfig {
+  const AppAccountConfig({
+    required this.enabled,
+    required this.emailEnabled,
+    required this.apiBaseUrl,
+    required this.privacyUrl,
+    required this.privacyVersion,
+    this.allowInsecureDev = false,
+  });
+
+  const AppAccountConfig.disabled()
+    : enabled = false,
+      emailEnabled = false,
+      apiBaseUrl = '',
+      privacyUrl = '',
+      privacyVersion = '',
+      allowInsecureDev = false;
+
+  factory AppAccountConfig.fromEnvironment() {
+    const appEnvironment = String.fromEnvironment('APP_ENV');
+    return AppAccountConfig(
+      enabled: const bool.fromEnvironment('PICORADAR_ACCOUNTS_ENABLED'),
+      emailEnabled: const bool.fromEnvironment(
+        'PICORADAR_ACCOUNT_EMAIL_ENABLED',
+      ),
+      apiBaseUrl: const String.fromEnvironment('API_BASE_URL'),
+      privacyUrl: const String.fromEnvironment('PICORADAR_ACCOUNT_PRIVACY_URL'),
+      privacyVersion: const String.fromEnvironment(
+        'PICORADAR_ACCOUNT_PRIVACY_VERSION',
+      ),
+      allowInsecureDev:
+          appEnvironment == 'dev' &&
+          !kReleaseMode &&
+          const bool.fromEnvironment('PICORADAR_ACCOUNTS_ALLOW_INSECURE_LOCAL'),
+    );
+  }
+
+  final bool enabled;
+  final bool emailEnabled;
+  final String apiBaseUrl;
+  final String privacyUrl;
+  final String privacyVersion;
+  final bool allowInsecureDev;
+
+  Uri? get apiBaseUri => _parse(apiBaseUrl);
+  Uri? get privacyUri => _parse(privacyUrl);
+
+  bool get privacyConfigured =>
+      privacyVersion.trim().isNotEmpty &&
+      privacyUri != null &&
+      privacyUri!.scheme == 'https';
+
+  bool get isAvailable {
+    final api = apiBaseUri;
+    if (!enabled || !emailEnabled || api == null) return false;
+    if (api.scheme == 'https') return true;
+    return allowInsecureDev &&
+        api.scheme == 'http' &&
+        const {'localhost', '127.0.0.1', '::1'}.contains(api.host);
+  }
+
+  Uri? _parse(String raw) {
+    final uri = Uri.tryParse(raw.trim());
+    if (uri == null ||
+        !uri.hasScheme ||
+        uri.host.isEmpty ||
+        uri.userInfo.isNotEmpty ||
+        uri.hasQuery ||
+        uri.hasFragment) {
+      return null;
+    }
+    return uri;
+  }
+}
diff --git a/mobile/lib/features/account/presentation/app_account_settings.dart b/mobile/lib/features/account/presentation/app_account_settings.dart
new file mode 100644
index 0000000..56cf143
--- /dev/null
+++ b/mobile/lib/features/account/presentation/app_account_settings.dart
@@ -0,0 +1,396 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:url_launcher/url_launcher.dart';
+
+import '../data/app_account_client.dart';
+import '../data/app_account_config.dart';
+
+class AppAccountSettingsSection extends ConsumerStatefulWidget {
+  const AppAccountSettingsSection({super.key});
+
+  @override
+  ConsumerState<AppAccountSettingsSection> createState() =>
+      _AppAccountSettingsSectionState();
+}
+
+class _AppAccountSettingsSectionState
+    extends ConsumerState<AppAccountSettingsSection> {
+  final _email = TextEditingController();
+  final _code = TextEditingController();
+  final _name = TextEditingController();
+  final _phone = TextEditingController();
+  final _municipality = TextEditingController();
+  final _categories = <String>{};
+  AppAccountProfile? _profile;
+  bool _privacyAccepted = false;
+  bool _marketing = false;
+  bool _otpRequested = false;
+  bool _busy = false;
+  String? _message;
+  String? _error;
+
+  @override
+  void dispose() {
+    _email.dispose();
+    _code.dispose();
+    _name.dispose();
+    _phone.dispose();
+    _municipality.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final config = ref.watch(appAccountConfigProvider);
+    if (!config.isAvailable) {
+      return const Card(
+        key: ValueKey('account-unavailable'),
+        child: ListTile(
+          leading: Icon(Icons.person_outline),
+          title: Text('Cuenta opcional'),
+          subtitle: Text(
+            'No disponible todavía. PicoRadar funciona sin cuenta.',
+          ),
+        ),
+      );
+    }
+
+    return Card(
+      key: const ValueKey('account-settings-card'),
+      child: Padding(
+        padding: const EdgeInsets.all(16),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            Text(
+              'Cuenta opcional',
+              style: Theme.of(context).textTheme.titleMedium,
+            ),
+            const SizedBox(height: 4),
+            const Text('PicoRadar sigue funcionando sin inicio de sesión.'),
+            if (_profile == null) ..._loginFields(config),
+            if (_profile != null) ..._profileFields(),
+            if (_message != null)
+              Padding(
+                padding: const EdgeInsets.only(top: 10),
+                child: Text(_message!, key: const ValueKey('account-status')),
+              ),
+            if (_error != null)
+              Padding(
+                padding: const EdgeInsets.only(top: 10),
+                child: Text(
+                  _error!,
+                  key: const ValueKey('account-error'),
+                  style: TextStyle(color: Theme.of(context).colorScheme.error),
+                ),
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  List<Widget> _loginFields(AppAccountConfig config) => [
+    const SizedBox(height: 12),
+    Align(
+      alignment: Alignment.centerLeft,
+      child: TextButton.icon(
+        key: const ValueKey('account-restore-session'),
+        onPressed: _busy ? null : _restoreSession,
+        icon: const Icon(Icons.lock_open_outlined),
+        label: const Text('Revisar sesión guardada'),
+      ),
+    ),
+    TextField(
+      key: const ValueKey('account-email'),
+      controller: _email,
+      keyboardType: TextInputType.emailAddress,
+      autofillHints: const [AutofillHints.email],
+      decoration: const InputDecoration(labelText: 'Correo'),
+    ),
+    if (config.privacyConfigured) ...[
+      CheckboxListTile(
+        key: const ValueKey('account-privacy-consent'),
+        contentPadding: EdgeInsets.zero,
+        value: _privacyAccepted,
+        onChanged: (value) => setState(() => _privacyAccepted = value == true),
+        title: const Text(
+          'Si es una cuenta nueva, acepto la política de privacidad vigente.',
+        ),
+        subtitle: Text(
+          'Versión ${config.privacyVersion} · Los datos del garaje no se envían.',
+        ),
+      ),
+      Align(
+        alignment: Alignment.centerLeft,
+        child: TextButton(
+          key: const ValueKey('account-open-privacy'),
+          onPressed: () => launchUrl(
+            config.privacyUri!,
+            mode: LaunchMode.externalApplication,
+          ),
+          child: const Text('Leer política de privacidad'),
+        ),
+      ),
+    ] else
+      const Text(
+        'Las altas nuevas esperan la configuración de la política vigente. Las cuentas existentes aún pueden solicitar acceso.',
+      ),
+    if (_otpRequested)
+      TextField(
+        key: const ValueKey('account-otp'),
+        controller: _code,
+        keyboardType: TextInputType.number,
+        maxLength: 8,
+        decoration: const InputDecoration(labelText: 'Código de acceso'),
+      ),
+    const SizedBox(height: 8),
+    Wrap(
+      spacing: 8,
+      runSpacing: 8,
+      children: [
+        OutlinedButton(
+          key: const ValueKey('account-request-otp'),
+          onPressed: _busy ? null : _requestOtp,
+          child: const Text('Solicitar código'),
+        ),
+        if (_otpRequested)
+          FilledButton(
+            key: const ValueKey('account-verify-otp'),
+            onPressed: _busy ? null : _verifyOtp,
+            child: const Text('Verificar código'),
+          ),
+      ],
+    ),
+  ];
+
+  List<Widget> _profileFields() => [
+    const SizedBox(height: 12),
+    Text('Correo verificado: ${_profile!.email}'),
+    TextField(
+      key: const ValueKey('account-name'),
+      controller: _name,
+      maxLength: 120,
+      decoration: const InputDecoration(labelText: 'Nombre (opcional)'),
+    ),
+    TextField(
+      key: const ValueKey('account-phone'),
+      controller: _phone,
+      maxLength: 24,
+      keyboardType: TextInputType.phone,
+      decoration: const InputDecoration(labelText: 'Teléfono (opcional)'),
+    ),
+    TextField(
+      key: const ValueKey('account-municipality'),
+      controller: _municipality,
+      maxLength: 120,
+      decoration: const InputDecoration(
+        labelText: 'Municipio declarado (opcional)',
+      ),
+    ),
+    const Padding(
+      padding: EdgeInsets.only(top: 8),
+      child: Text('Categorías declaradas (opcionales)'),
+    ),
+    for (final category in const {
+      'car': 'Carro',
+      'motorcycle': 'Motocicleta',
+      'taxi': 'Taxi',
+      'public_service': 'Servicio público',
+    }.entries)
+      CheckboxListTile(
+        key: ValueKey('account-category-${category.key}'),
+        contentPadding: EdgeInsets.zero,
+        value: _categories.contains(category.key),
+        title: Text(category.value),
+        onChanged: (value) => setState(() {
+          value == true
+              ? _categories.add(category.key)
+              : _categories.remove(category.key);
+        }),
+      ),
+    SwitchListTile(
+      key: const ValueKey('account-marketing-consent'),
+      contentPadding: EdgeInsets.zero,
+      value: _marketing,
+      title: const Text('Recibir novedades comerciales por correo'),
+      subtitle: const Text('Opcional y separado del uso de la cuenta.'),
+      onChanged: _busy ? null : _changeMarketing,
+    ),
+    Wrap(
+      spacing: 8,
+      children: [
+        FilledButton(
+          key: const ValueKey('account-save-profile'),
+          onPressed: _busy ? null : _saveProfile,
+          child: const Text('Guardar perfil'),
+        ),
+        OutlinedButton(
+          key: const ValueKey('account-logout'),
+          onPressed: _busy ? null : _logout,
+          child: const Text('Cerrar sesión'),
+        ),
+        TextButton(
+          key: const ValueKey('account-delete'),
+          onPressed: _busy ? null : _confirmDelete,
+          child: const Text('Eliminar cuenta'),
+        ),
+      ],
+    ),
+  ];
+
+  Future<void> _requestOtp() async {
+    final config = ref.read(appAccountConfigProvider);
+    if (_email.text.trim().isEmpty) {
+      setState(() => _error = 'Escribe el correo de tu cuenta.');
+      return;
+    }
+    await _run(() async {
+      await ref
+          .read(appAccountClientProvider)
+          .requestOtp(_email.text, privacyAccepted: _privacyAccepted);
+      _otpRequested = true;
+      _message = config.privacyConfigured
+          ? _privacyAccepted
+                ? 'Solicitud procesada. Si la cuenta está habilitada, revisa el correo; no compartas el código.'
+                : 'Si ya tienes cuenta, revisa el correo. Para crear una cuenta nueva debes aceptar la política vigente.'
+          : 'Si ya tienes una cuenta, revisa el correo. No se tramitan altas nuevas sin política configurada.';
+    });
+  }
+
+  Future<void> _restoreSession() async {
+    await _run(() async {
+      final profile = await ref.read(appAccountClientProvider).loadProfile();
+      _applyProfile(profile);
+      _message = 'Sesión recuperada. Los datos del garaje no se sincronizan.';
+    });
+  }
+
+  Future<void> _verifyOtp() async {
+    await _run(() async {
+      final profile = await ref
+          .read(appAccountClientProvider)
+          .verifyOtp(_email.text, _code.text);
+      _applyProfile(profile);
+      _message = 'Cuenta conectada. Los vehículos y documentos siguen locales.';
+    });
+  }
+
+  Future<void> _saveProfile() async {
+    await _run(() async {
+      final profile = await ref
+          .read(appAccountClientProvider)
+          .updateProfile(
+            name: _name.text,
+            phone: _phone.text,
+            municipality: _municipality.text,
+            categories: _categories.toList(growable: false),
+          );
+      _applyProfile(profile);
+      _message = 'Perfil guardado.';
+    });
+  }
+
+  Future<void> _changeMarketing(bool accepted) async {
+    final previous = _marketing;
+    setState(() => _marketing = accepted);
+    await _run(() async {
+      _marketing = await ref
+          .read(appAccountClientProvider)
+          .updateMarketing(accepted);
+      _message = accepted
+          ? 'Preferencia comercial activada.'
+          : 'Preferencia comercial desactivada.';
+    }, marketingFallback: previous);
+  }
+
+  Future<void> _logout() async {
+    await _run(() async {
+      await ref.read(appAccountClientProvider).logout();
+      _reset();
+      _message =
+          'Sesión cerrada. Los datos locales del dispositivo se conservaron.';
+    });
+  }
+
+  Future<void> _confirmDelete() async {
+    final confirmed = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        title: const Text('Eliminar cuenta'),
+        content: const Text(
+          'Se borrará el perfil de cuenta del servidor. Vehículos y documentos de este dispositivo se conservarán.',
+        ),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.pop(context, false),
+            child: const Text('Cancelar'),
+          ),
+          FilledButton(
+            onPressed: () => Navigator.pop(context, true),
+            child: const Text('Eliminar cuenta'),
+          ),
+        ],
+      ),
+    );
+    if (confirmed != true || !mounted) return;
+    await _run(() async {
+      await ref.read(appAccountClientProvider).suppress();
+      _reset();
+      _message =
+          'Cuenta eliminada. Los datos locales del dispositivo se conservaron.';
+    });
+  }
+
+  Future<void> _run(
+    Future<void> Function() action, {
+    bool? marketingFallback,
+  }) async {
+    setState(() {
+      _busy = true;
+      _error = null;
+      _message = null;
+    });
+    try {
+      await action();
+    } on AppAccountFailure catch (failure) {
+      _error = switch (failure.code) {
+        'not_configured' => 'No disponible todavía.',
+        'unauthorized' || 'invalid_or_expired_code' => 'El código o la sesión no se pudo confirmar. Revisa el dato e inténtalo de nuevo.',
+        'rate_limited' =>
+          'Demasiados intentos. Espera antes de volver a solicitarlo.',
+        _ => 'No se pudo completar la solicitud. Inténtalo más tarde.',
+      };
+      if (marketingFallback != null) _marketing = marketingFallback;
+    } catch (_) {
+      _error = 'No se pudo completar la solicitud. Inténtalo más tarde.';
+      if (marketingFallback != null) _marketing = marketingFallback;
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  void _applyProfile(AppAccountProfile profile) {
+    _profile = profile;
+    _name.text = profile.name;
+    _phone.text = profile.phone;
+    _municipality.text = profile.municipality;
+    _categories
+      ..clear()
+      ..addAll(profile.categories);
+    _marketing = profile.marketingConsent;
+  }
+
+  void _reset() {
+    _profile = null;
+    _email.clear();
+    _otpRequested = false;
+    _privacyAccepted = false;
+    _code.clear();
+    _name.clear();
+    _phone.clear();
+    _municipality.clear();
+    _categories.clear();
+    _marketing = false;
+  }
+}
