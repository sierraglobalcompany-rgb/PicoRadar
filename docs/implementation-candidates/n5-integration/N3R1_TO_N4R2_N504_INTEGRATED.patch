@@ -0,0 +1,55 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\AppAccessToken;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+
+class AppAccountUnsubscribeController extends Controller
+{
+    public function show(string $token)
+    {
+        $access = $this->findToken($token);
+
+        return view('app-account.unsubscribe', ['available' => $access !== null]);
+    }
+
+    public function store(Request $request, string $token)
+    {
+        DB::transaction(function () use ($token): void {
+            $access = $this->findToken($token, lock: true);
+            if ($access?->appUser && $access->purpose === 'unsubscribe') {
+                $access->appUser->forceFill([
+                    'marketing_consent' => false,
+                    'marketing_version' => null,
+                    'marketing_consented_at' => null,
+                ])->save();
+                $access->forceFill(['used_at' => now()])->save();
+            }
+        });
+
+        return redirect()->route('app-users.unsubscribe.show', ['token' => $token, ...$request->query()])
+            ->with('status', 'Tu preferencia de comunicaciones fue actualizada.');
+    }
+
+    private function findToken(string $plain, bool $lock = false): ?AppAccessToken
+    {
+        if (! preg_match('/^[a-f0-9]{64}$/D', $plain)) {
+            return null;
+        }
+        $query = AppAccessToken::query()
+            ->with('appUser')
+            ->where('purpose', 'unsubscribe')
+            ->where('token_hash', hash('sha256', $plain))
+            ->whereNull('used_at')
+            ->whereNull('revoked_at')
+            ->where('expires_at', '>', now());
+        if ($lock) {
+            $query->lockForUpdate();
+        }
+        $access = $query->first();
+
+        return $access && hash_equals($access->token_hash, hash('sha256', $plain)) ? $access : null;
+    }
+}
diff --git a/server/app/Http/Middleware/AuthenticateAppAccount.php b/server/app/Http/Middleware/AuthenticateAppAccount.php
new file mode 100644
index 0000000..748c046
--- /dev/null
+++ b/server/app/Http/Middleware/AuthenticateAppAccount.php
@@ -0,0 +1,50 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\AppAccessToken;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class AuthenticateAppAccount
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        if (! config('app_accounts.enabled') && ! app()->environment('testing')) {
+            return response()->json(['error' => ['code' => 'not_configured']], 503);
+        }
+
+        $plainToken = $request->bearerToken();
+        if (! is_string($plainToken) || ! preg_match('/^[a-f0-9]{64}$/D', $plainToken)) {
+            return $this->unauthorized();
+        }
+
+        $tokenHash = hash('sha256', $plainToken);
+        $access = AppAccessToken::query()
+            ->with('appUser')
+            ->where('purpose', 'session')
+            ->where('token_hash', $tokenHash)
+            ->whereNull('revoked_at')
+            ->where('expires_at', '>', now())
+            ->first();
+
+        if (
+            ! $access?->appUser
+            || ! $access->appUser->email_verified_at
+            || ! hash_equals($access->token_hash, $tokenHash)
+        ) {
+            return $this->unauthorized();
+        }
+
+        $request->attributes->set('appAccount', $access->appUser);
+        $request->attributes->set('appAccountToken', $access);
+
+        return $next($request);
+    }
+
+    private function unauthorized(): Response
+    {
+        return response()->json(['error' => ['code' => 'unauthorized']], 401);
+    }
+}
