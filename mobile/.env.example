# PicoRadar mobile local configuration example.
# Pass these values with --dart-define; do not commit real secrets.

APP_ENV=dev
API_BASE_URL=https://api-dev.picoradar.example.invalid
CDN_BASE_URL=https://cdn-dev.picoradar.example.invalid
FEATURE_MANIFEST_URL=https://cdn-dev.picoradar.example.invalid/v1/manifest.json
CRASH_REPORTING_ENABLED=false
ROUTE_PROVIDER_ENABLED=false
