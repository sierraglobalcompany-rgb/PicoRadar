APP_NAME=PicoRadar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Production: set APP_ENV=production, APP_DEBUG=false and APP_URL=https://<your-domain>.
# Serve Laravel from public/ and keep this file outside the document root.

APP_LOCALE=en
CAMERA_REVERIFY_AFTER_DAYS=180
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Local SQLite default: database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=picoradar
# DB_USERNAME=picoradar_user
# DB_PASSWORD=
# Production uses MariaDB/MySQL with DB_CONNECTION=mysql and the values above.

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production HTTPS: SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Drafts use Laravel's private local disk. Published JSON and manifest use public/
# and are served after `php artisan storage:link`.
DATASET_DRAFT_DISK=local
DATASET_PUBLISHED_DISK=public
DATASET_PUBLIC_BASE_URL=/storage
DATASET_MAX_UPLOAD_KB=5120
PICORADAR_MIN_APP_VERSION=1.0.0
DATASET_MANIFEST_LOCK_SECONDS=60
DATASET_MANIFEST_LOCK_WAIT_SECONDS=10
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# Trip provider stays OFF until owner-approved access, license, budget and environment.
# Never put this key in Flutter/dart-define. No live calls are authorized by this example.
TRIPS_ENABLED=false
TOLLGURU_API_KEY=
TRIPS_ACCESS_AUTHORIZED=false
TRIPS_LICENSE_AUTHORIZED=false
TRIPS_CONFIRMED_FREE=false
TRIPS_AUTHORIZATION_EXPIRES_AT=
TRIPS_BUDGET_ID=
TRIPS_BUDGET_CURRENCY=
TRIPS_MAX_REQUESTS=0
TRIPS_MAX_UNITS=0
TRIPS_MAX_MONEY_MINOR=0
TRIPS_UNITS_PER_REQUEST=0
TRIPS_MONEY_MINOR_PER_REQUEST=0
# Existing database cache + locked durable ledger required: see config/trips.php.
# Missing ledger fails closed; clearing cache does not renew the allowance.

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
