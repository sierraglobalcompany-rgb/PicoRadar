APP_NAME=PicoRadar
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.invalid

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=picoradar_staging
DB_USERNAME=picoradar_staging
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=array

DATASET_DRAFT_DISK=local
DATASET_PUBLISHED_DISK=public
DATASET_PUBLIC_BASE_URL=/storage
DATASET_MAX_UPLOAD_KB=5120
PICORADAR_MIN_APP_VERSION=1.0.0

# These capabilities remain fail-closed until a later approved lot.
TRIPS_ENABLED=false
TRIPS_ACCESS_AUTHORIZED=false
TRIPS_LICENSE_AUTHORIZED=false
PRIVATE_OSRM_ENABLED=false
PRIVATE_OSRM_BASE_URL=
PRIVATE_OSRM_ACCESS_AUTHORIZED=false
PRIVATE_OSRM_SOURCE_AUTHORIZED=false
PARTNER_INQUIRIES_ENABLED=false
PARTNER_INQUIRIES_ADMIN_INBOX_ENABLED=false
PARTNER_INQUIRIES_PRIVACY_VERSION=
PARTNER_INQUIRIES_PRIVACY_URL=
PARTNER_INQUIRIES_ALLOW_INSECURE_LOCAL=false
